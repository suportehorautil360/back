# App
PORT=3000

# JWT/Auth
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=24h

# Firebase Firestore database id (usually "default")
FIREBASE_DATABASE_ID=default

# Option A: Use a service account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Option B: Use explicit service account fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: URL do app da oficina (links em e-mails)
OFICINA_WEB_URL=http://localhost:3001

# Optional: Resend (e-mail transacional — esqueci senha, alertas, etc.)
RESEND_API_KEY=
# Opção A (recomendada — evita problema de espaços no .env):
MAIL_FROM_EMAIL=noreply@horautil360.com
MAIL_FROM_NAME=Hora Útil 360
# Opção B (use aspas se for uma linha só):
# MAIL_FROM="Hora Útil 360 <noreply@horautil360.com>"
POSTO_WEB_URL=http://localhost:3004

# Supabase Storage (upload de fotos do checklist — módulo uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_CHECKLISTS=checklists
# Opcional: bucket dedicado para PDFs de NF. Se omitido, usa checklists/notas-fiscais/
# SUPABASE_BUCKET_NOTAS_FISCAIS=notas-fiscais

# Admin (Hub WhatsApp no portal 360 — header x-admin-secret)
ADMIN_SECRET=change_me_admin_secret

# WhatsApp remoto (opcional): quando definido, o back NÃO sobe Baileys local e
# repassa status/conexão/envio para outro serviço (ex.: Railway dedicado).
# A URL deve incluir o prefixo das rotas, ex.: https://seu-wa.railway.app/whatsapp
WHATSAPP_SERVICE_URL=
# Segredo do serviço remoto (se omitido, usa ADMIN_SECRET)
WHATSAPP_SERVICE_SECRET=

# Evolution API (prioridade sobre WHATSAPP_SERVICE_URL e Baileys local)
EVOLUTION_BASE_URL=https://evolution-api-production-4ef6.up.railway.app
EVOLUTION_AUTH_KEY=
# Nome da instance criada no Manager (recomendado; senão usa a 1ª conectada)
EVOLUTION_INSTANCE=
# Opcional: URL do Manager (padrão: EVOLUTION_BASE_URL/manager)
EVOLUTION_MANAGER_URL=
